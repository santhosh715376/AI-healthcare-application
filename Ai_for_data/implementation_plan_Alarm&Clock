## 4. Code Implementation (`frontend/src/utils/audioAlarm.js` & `AdherenceClock.jsx`)

```javascript
// HTML5 Web Audio API Alarm Synthesizer (`frontend/src/utils/audioAlarm.js`)

let audioCtx = None;

export function playMedicalAlarm(type = 'DUE') {
  try {
    if (!audioCtx) {
      audioCtx = new (window.AudioContext || window.webkitAudioContext)();
    }

    const osc = audioCtx.createOscillator();
    const gain = audioCtx.createGain();
    osc.connect(gain);
    gain.connect(audioCtx.destination);

    if (type === 'PRE_REMINDER') {
      // Soft 2-tone pre-reminder chime (523Hz C5 -> 659Hz E5)
      osc.frequency.setValueAtTime(523.25, audioCtx.currentTime);
      osc.frequency.exponentialRampToValueAtTime(659.25, audioCtx.currentTime + 0.3);
      gain.gain.setValueAtTime(0.15, audioCtx.currentTime);
      gain.gain.exponentialRampToValueAtTime(0.01, audioCtx.currentTime + 0.5);
      osc.start();
      osc.stop(audioCtx.currentTime + 0.5);
    } else {
      // Urgent overdue medical alarm (3 pulsing beeps at 880Hz A5)
      const now = audioCtx.currentTime;
      for (let i = 0; i < 3; i++) {
        const toneOsc = audioCtx.createOscillator();
        const toneGain = audioCtx.createGain();
        toneOsc.type = 'sine';
        toneOsc.frequency.setValueAtTime(880, now + (i * 0.25));
        toneGain.gain.setValueAtTime(0.3, now + (i * 0.25));
        toneGain.gain.exponentialRampToValueAtTime(0.01, now + (i * 0.25) + 0.15);
        toneOsc.connect(toneGain);
        toneGain.connect(audioCtx.destination);
        toneOsc.start(now + (i * 0.25));
        toneOsc.stop(now + (i * 0.25) + 0.15);
      }
    }
  } catch (e) {
    console.warn("Web Audio API not supported or blocked by user gesture policy:", e);
  }
}
```

