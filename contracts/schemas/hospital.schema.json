{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Hospital",
  "type": "object",
  "properties": {
    "id": { "type": "string" },
    "name": { "type": "string" },
    "specialties": {
      "type": "array",
      "items": { "type": "string" }
    },
    "location": {
      "type": "object",
      "properties": {
        "lat": { "type": "number" },
        "lng": { "type": "number" },
        "address": { "type": "string" }
      },
      "required": ["lat", "lng"]
    },
    "emergencyServices": { "type": "boolean" },
    "acceptedInsurance": {
      "type": "array",
      "items": { "type": "string" }
    },
    "rating": { "type": "number" }
  },
  "required": ["id", "name", "specialties", "location"]
}
