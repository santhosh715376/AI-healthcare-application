{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AgentResponse",
  "type": "object",
  "properties": {
    "specialtySuggestion": {
      "type": "object",
      "properties": {
        "suggestedSpecialty": { "type": "string" },
        "reasoning": { "type": "string" },
        "confidence": { "type": "number" }
      }
    },
    "rankedHospitals": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "hospitalId": { "type": "string" },
          "hospitalName": { "type": "string" },
          "rank": { "type": "integer" },
          "score": { "type": "number" },
          "reason": { "type": "string" }
        },
        "required": ["hospitalId", "rank", "score", "reason"]
      }
    }
  }
}
